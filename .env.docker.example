# ════════════════════════════════════════════════════════════════
# POS Docker — Environment Variables
# ════════════════════════════════════════════════════════════════
# كيفية الاستخدام:
#   1. انسخ هذا الملف:  copy .env.docker.example .env
#   2. غيّر كلمة المرور أدناه وأي إعدادات أخرى
#   3. شغّل: docker-compose up -d --build
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
# كلمة مرور قاعدة البيانات (غيّرها لقيمة آمنة!)
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD

# Required: replace both placeholders with unique, randomly generated secrets.

# ── Security & HTTPS ───────────────────────────────────────────
# Production must be published through a TLS-terminating reverse proxy.
# Keep both values true; direct HTTP access to port 8000 is not supported.
FORCE_HTTPS=true
SECURE_COOKIES=true
DEPLOYMENT_MODE=web

# ── Frontend ───────────────────────────────────────────────────
# رابط الواجهة الأمامية
FRONTEND_URL=https://pos.example.com

# ── Redis (اختياري) ────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── App Settings ───────────────────────────────────────────────
TOKEN_LIFETIME=14400
LOW_STOCK_THRESHOLD=5
TAX_RATE=0.15
QZ_PRIVATE_KEY_PATH=

# ── CORS Configuration ─────────────────────────────────────────
# Comma-separated list of allowed origins for tablet/phone access
# Example: CORS_ALLOWED_ORIGINS="http://192.168.1.100:8080,http://192.168.1.101:8080"
CORS_ALLOWED_ORIGINS=""
# Set to true to allow ANY device on the local network (less secure)
CORS_ALLOW_LAN=false

# Updates are disabled by default until a pinned, signed release is configured.
ENABLE_UPDATE_CHECKS=false
ENABLE_AUTO_UPDATE=false
UPDATE_SERVER_URL=https://api.github.com/repos/ABDO-TECK/pos-desktop/releases/latest
UPDATE_ALLOWED_HOSTS=api.github.com,raw.githubusercontent.com
UPDATE_COMMIT_SHA=
