# ════════════════════════════════════════════════════════════════
# POS System — Environment Configuration (Example)
# ════════════════════════════════════════════════════════════════
# كيفية الاستخدام:
#   1. انسخ هذا الملف:  copy .env.example .env
#   2. عدّل القيم أدناه حسب بيئتك (مثل كلمة مرور قاعدة البيانات)
#   3. لا تُضف .env إلى Git أبداً (الملف محمي افتراضياً)
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=pos_db
DB_USER=pos_user
DB_PASS=REPLACE_ME_WITH_A_UNIQUE_SECRET
DB_CHARSET=utf8mb4
DB_PORT=3307

# ── Database (Migration Account - Schema Administration Only) ───
# المستخدم المخصص لإدارة المخطط وتشغيل المهاجرات فقط (CREATE, ALTER, DROP, TRIGGER, etc.)
# ملاحظة لمخدمات MySQL 8 الخارجية عند تفعيل Binary Logging:
# يتطلب إنشاء الـ Triggers إما تفعيل log_bin_trust_function_creators=1 على الخادم
# أو امتلاك المستخدم لصلاحية SUPER (غير مفضل أمنياً). البيئة المضمنة تستخدم MariaDB
# ولا تتطلب هذا الإعداد.
DB_MIGRATION_USER=pos_migration
DB_MIGRATION_PASS=REPLACE_ME_WITH_A_UNIQUE_MIGRATION_SECRET

# تفعيل Persistent Connections (مُوصى به في الإنتاج مع Apache/php-fpm)
# اتركه false في التطوير المحلي أو مع Electron
DB_PERSISTENT=false

# ── Application ────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=production
APP_DEBUG=false
# IANA timezone used by logs, reports, invoices, and scheduled jobs.
# Electron automatically supplies the operating-system timezone for desktop runs.
APP_TIMEZONE=Africa/Cairo
# desktop: Electron/PHP loopback only; web: externally hosted; lan: LAN proxy
DEPLOYMENT_MODE=web
# Development-only opt-in. Production and desktop migrations run before the
# HTTP server starts and never from the request path.
AUTO_MIGRATE=false
# Maximum decoded JSON request payload read by the application (1 MiB by default)
JSON_BODY_MAX_BYTES=1048576

# ── Security & HTTPS ───────────────────────────────────────────
# FORCE_HTTPS: يُعيد توجيه HTTP إلى HTTPS تلقائياً
# SECURE_COOKIES: يُرسل الكوكيز عبر اتصال مشفر فقط
# ⚠️ في بيئة الإنتاج الحقيقية: يجب أن تكون كلاهما true
FORCE_HTTPS=true
SECURE_COOKIES=true

# ── CSRF Protection ────────────────────────────────────────────
# Secret key for HMAC-signed CSRF tokens (generate a random 64-char hex string)
# إذا تُرك فارغاً، يتم اشتقاق مفتاح تلقائياً من إعدادات قاعدة البيانات
CSRF_SECRET=""

# ── Redis (اختياري) ────────────────────────────────────────────
# اتركه فارغاً لاستخدام التخزين المحلي للملفات بدلاً من Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth Token ─────────────────────────────────────────────────
# مدة صلاحية Access Token بالثواني (14400 = 4 ساعات)
# Refresh Token يُجدّد التوكن تلقائياً قبل انتهاء الصلاحية
TOKEN_LIFETIME=14400

# ── Inventory ──────────────────────────────────────────────────
# حد المخزون المنخفض الافتراضي (يمكن تعديله من إعدادات المتجر لاحقاً)
LOW_STOCK_THRESHOLD=5

# ── Tax ────────────────────────────────────────────────────────
# نسبة الضريبة (0.15 = 15%)
TAX_RATE=0.15

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── QZ Tray (Thermal Printing) ─────────────────────────────────
# المسار الكامل لملف المفتاح الخاص لتوقيع طباعة QZ Tray
# اتركه فارغاً للعمل بدون توقيع (وضع التطوير والمحلي)
QZ_PRIVATE_KEY_PATH=""

# ── Updates Configuration ──────────────────────────────────────
# تمكين أو تعطيل التحقق من التحديثات السحابية
# set ENABLE_UPDATE_CHECKS=false only for offline/private deployments
ENABLE_UPDATE_CHECKS=true
# Separate opt-in for applying updates from the admin API (keep false unless operated)
ENABLE_AUTO_UPDATE=false
# رابط خادم التحديثات (اتركه فارغاً لتعطيله)
# leave UPDATE_SERVER_URL empty only if updates are intentionally disabled
UPDATE_SERVER_URL=https://api.github.com/repos/ABDO-TECK/pos-desktop/contents/version.json?ref=main
# Host allowlist for update checks (HTTPS only; no redirects are followed)
UPDATE_ALLOWED_HOSTS=api.github.com,raw.githubusercontent.com
# Required for applying updates: the exact 40-character signed release commit
UPDATE_COMMIT_SHA=

# ── CORS Configuration ─────────────────────────────────────────
# Comma-separated list of allowed origins for tablet/phone access
# Example: CORS_ALLOWED_ORIGINS="http://192.168.1.100:8080,http://192.168.1.101:8080"
CORS_ALLOWED_ORIGINS=""
# Set to true to allow ANY device on the local network (less secure)
CORS_ALLOW_LAN=false
