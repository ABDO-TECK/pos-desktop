{
  "blockedCommitPatterns": [
    "dist-electron/**",
    "node_modules/**",
    "vendor/**",
    "tmp/**",
    "scratch/**",
    "out/**",
    "portable/**",
    "tray/**",
    "build-tools/**",
    "frontend/dist/**",
    "frontend/node_modules/**",
    "frontend/.vite/**",
    "frontend/.cache/**",
    "frontend/test-results/**",
    "frontend/playwright-report/**",
    "frontend/coverage/**",
    "frontend/tsc_output.txt",
    "backend/vendor/**",
    "backend/.phpunit.result.cache",
    "backend/storage/**",
    "backend/logs/**",
    "backend/temp/**",
    "backend/tmp/**",
    "backend/cache/**",
    "backend/backups/**",
    "backend/runtime/**",
    "backend/uploads/**",
    ".env",
    ".env.*",
    "*.log",
    "*.tmp",
    "*.sqlite",
    "*.db",
    "*.bak",
    "*.cache",
    "Thumbs.db",
    "desktop.ini",
    ".DS_Store"
  ],
  "warningCommitPatterns": [
    "backend/backend.phar",
    "package-lock.json",
    "package.json",
    "version.json",
    "dist-electron/latest.yml",
    "dist-electron/*.exe",
    "dist-electron/*.blockmap",
    "*.phar",
    "*.exe",
    "*.dll",
    "*.bin",
    "*.zip",
    "*.7z",
    "*.tar",
    "*.gz"
  ],
  "safeCommitPatterns": [
    "frontend/src/**",
    "frontend/*.config.*",
    "frontend/vite.config.*",
    "frontend/playwright.config.*",
    "frontend/tests/**",
    "electron/**",
    "backend/WebSocket/**",
    "backend/cli/**",
    "backend/config/**",
    "backend/middleware/**",
    "backend/repositories/**",
    "backend/Repositories/**",
    "backend/models/**",
    "backend/Models/**",
    "backend/index.php",
    "backend/Services/**",
    "backend/Controllers/**",
    "backend/services/**",
    "backend/controllers/**",
    "backend/routes/**",
    "backend/tests/**",
    "scripts/**",
    "docs/**",
    "backend/certs/**",
    "build-phar.php",
    "README.md",
    "package.json",
    "package-lock.json",
    "version.json"
  ],
  "versionTextFiles": [
    {
      "path": "README.md",
      "patterns": [
        {
          "name": "README version badge",
          "regex": "version-\\d+\\.\\d+\\.\\d+-blue\\.svg",
          "replacement": "version-{version}-blue.svg"
        }
      ]
    }
  ],
  "defaultBranch": "main",
  "repoOwner": "ABDO-TECK",
  "repoName": "pos-desktop",
  "productName": "POS System",
  "installerNamePattern": "*{version}*Setup*.exe"
}
